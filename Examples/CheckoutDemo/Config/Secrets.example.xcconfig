// Copy this file to Secrets.xcconfig and paste your own Crossmint client key.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// The environment comes from the key prefix: ck_staging_ talks to
// staging.crossmint.com, ck_production_ talks to www.crossmint.com.

CROSSMINT_API_KEY = ck_staging_YOUR_API_KEY
